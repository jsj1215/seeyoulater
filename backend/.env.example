# Base64 인코딩된 256bit 이상 키. 생성: openssl rand -base64 48
JWT_SECRET=

# 미설정 시 docker-compose 기본값(seeyoulater/seeyoulater) 사용
DB_URL=jdbc:postgresql://localhost:5432/seeyoulater
DB_USERNAME=seeyoulater
DB_PASSWORD=seeyoulater

# 인증 쿠키 Secure 플래그. 기본 true. Safari로 http://localhost 개발할 때만 false
COOKIE_SECURE=true

# 허용할 프론트엔드 Origin (콤마 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173
